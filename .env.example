# Copie para .env e preencha com os valores reais.
# .env é ignorado pelo git — nenhum token pode entrar no repositório.
# Em produção esses valores vivem em Settings > Secrets and variables > Actions.

# ---- Kommo CRM ----
KOMMO_SUBDOMAIN=taiyohonda
KOMMO_TOKEN=<token-de-longa-duracao-do-kommo>

# ---- Meta Ads ----
# Ideal: System User token do BM "Negócios Taiyo" (118780010629826) com ads_read.
META_TOKEN=<access-token-do-meta>
META_ACCOUNT_NOVOS=act_1667526963623142
META_ACCOUNT_POSVENDAS=act_858960833896053
